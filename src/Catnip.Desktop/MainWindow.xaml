<Window x:Class="Catnip.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Catnip.Desktop.Mac.ViewModels"
        mc:Ignorable="d"
        Title="Catnip 0.0"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="NavRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="12,3" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavSurface"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#26344E" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#0A66C2" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#0A66C2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E8EEF6" />
            <Setter Property="Foreground" Value="#203047" />
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,5,0,12" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FAFCFF" />
        </Style>

        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="48" Height="26">
                            <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="13" />
                            <Ellipse x:Name="Thumb"
                                     Width="20"
                                     Height="20"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="White" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0A66C2" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#162238">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,24,16,20">
                    <TextBlock Text="Catnip" Foreground="White" FontSize="21" FontWeight="Bold" />
                    <TextBlock Margin="0,5,0,0" Text="Catnip · Windows" Foreground="#8FA3BF" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Content="⌂  首页"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsHomePage, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="home"
                                 Style="{StaticResource NavRadioStyle}" />
                    <RadioButton Content="☷  日志"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsLogsPage, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="logs"
                                 Style="{StaticResource NavRadioStyle}" />
                    <RadioButton Content="⚿  API 密钥配置"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsKeysPage, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="keys"
                                 Style="{StaticResource NavRadioStyle}" />
                    <RadioButton Content="◎  API 连接情况"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsConnectionsPage, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="connections"
                                 Style="{StaticResource NavRadioStyle}" />
                    <RadioButton Content="≡  过滤规则设置"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsFiltersPage, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="filters"
                                 Style="{StaticResource NavRadioStyle}" />
                </StackPanel>

                <Border Grid.Row="2" Margin="16" Padding="13" Background="#1D2C46" CornerRadius="9">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse Width="9" Height="9" Fill="#2AC769" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" />
                        </DockPanel>
                        <TextBlock Margin="0,9,0,0" Text="{Binding MemoryText, StringFormat=内存 {0}}" Foreground="#8FA3BF" FontSize="11" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Snapshot.Version, StringFormat=版本 {0}}" Foreground="#8FA3BF" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <DockPanel Margin="28,0">
                    <TextBlock VerticalAlignment="Center" Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" Foreground="#172033" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ApiConnectionText}" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,18,0" />
                        <TextBlock Text="Windows WPF 预览版" VerticalAlignment="Center" Foreground="#0A66C2" FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="28,22,28,24">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsHomePage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="服务控制" FontSize="17" FontWeight="SemiBold" Foreground="#172033" />
                                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="#2AC769" Margin="0,0,9,0" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Margin="12,2,0,0" Text="{Binding ProcessText}" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Margin="0,7,0,0" Text="{Binding StatusMessage}" Foreground="#64748B" TextWrapping="Wrap" />
                                    <DockPanel Margin="0,16,0,0">
                                        <TextBlock Text="{Binding Snapshot.McpAddress}" Foreground="#0A66C2" FontFamily="Consolas" VerticalAlignment="Center" />
                                        <Button Content="复制地址" Click="OnCopyAddressClicked" Style="{StaticResource SecondaryButtonStyle}" Margin="14,0,0,0" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="启动服务" Command="{Binding StartRuntimeCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="停止服务" Command="{Binding StopRuntimeCommand}" IsEnabled="{Binding CanStop}" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="运行模式与总开关" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,15" Text="开关采用悲观更新，Runtime 确认后界面才改变。" Foreground="#64748B" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="全量模式" Command="{Binding SetFullModeCommand}" IsEnabled="{Binding CanControl}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="自定义模式" Command="{Binding SetCustomModeCommand}" IsEnabled="{Binding CanControl}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <TextBlock Margin="8,9,0,0" Text="{Binding Snapshot.Mode, StringFormat=当前：{0}}" Foreground="#475569" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <ToggleButton IsChecked="{Binding Snapshot.MasterEnabled, Mode=OneWay}"
                                                  IsEnabled="{Binding CanControl}"
                                                  Command="{Binding ToggleMasterCommand}"
                                                  Style="{StaticResource SwitchStyle}" />
                                    <TextBlock Margin="0,7,0,0" Text="{Binding MasterToggleText}" HorizontalAlignment="Center" Foreground="#475569" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="2,0,0,10" Text="功能模块" FontSize="17" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Modules}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ModuleItemViewModel}">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,5,0,0" Text="{Binding Description}" Foreground="#64748B" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,10,0,0" Text="{Binding ConnectorText, StringFormat=连接器：{0}}" Foreground="#94A3B8" FontSize="12" />
                                                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Content="测试" Command="{Binding TestCommand}" IsEnabled="{Binding CanTest}" Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <ToggleButton IsChecked="{Binding Enabled, Mode=OneWay}"
                                                              IsEnabled="{Binding CanToggle}"
                                                              Command="{Binding ToggleCommand}"
                                                              Style="{StaticResource SwitchStyle}" />
                                                <TextBlock Margin="0,7,0,0" Text="{Binding EnabledText}" HorizontalAlignment="Center" Foreground="#64748B" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="WorkBuddy MCP 配置" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,14" Text="配置按当前安装目录动态生成，不写死开发机路径。" Foreground="#64748B" />
                                <TextBlock Text="Server 名称" Foreground="#475569" />
                                <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding WorkBuddyServerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
                                <TextBox Height="180"
                                         Padding="12"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="{Binding WorkBuddyConfigJson}" />
                                <StackPanel Margin="0,13,0,0" Orientation="Horizontal">
                                    <Button Content="复制 JSON" Click="OnCopyWorkBuddyConfigClicked" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="保存 mcp.json" Click="OnSaveWorkBuddyConfigClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="重新生成" Command="{Binding RefreshWorkBuddyConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding WorkBuddyConfigStatus}" Foreground="#64748B" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Visibility="{Binding IsLogsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="360" Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" Margin="0" />
                                <TextBlock Margin="10,10,0,0" Text="输入 TraceId、流或关键词过滤" Foreground="#94A3B8" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding LogsPauseText}" Command="{Binding ToggleLogsPauseCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="刷新" Command="{Binding RefreshLogsCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0">
                        <DataGrid ItemsSource="{Binding VisibleLogs}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  EnableRowVirtualization="True"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="120" />
                                <DataGridTextColumn Header="来源" Binding="{Binding Stream}" Width="120" />
                                <DataGridTextColumn Header="消息 / TraceId" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsKeysPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="和风天气 API 凭据" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,18" Text="这里配置的是 Server 调用外部天气 API 的凭据，不是 WorkBuddy 调用 Server 的 Key。" Foreground="#64748B" TextWrapping="Wrap" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="API Host" />
                                    <TextBox Text="{Binding WeatherApiHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="默认测试城市" />
                                    <TextBox Text="{Binding WeatherDefaultCity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="项目名称" />
                                    <TextBox Text="{Binding WeatherProjectName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="项目 ID" />
                                    <TextBox Text="{Binding WeatherProjectId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="凭据名称" />
                                    <TextBox Text="{Binding WeatherCredentialName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="凭据 ID" />
                                    <TextBox Text="{Binding WeatherCredentialId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="API KEY（留空表示保留数据库中的现有 Key）" />
                            <PasswordBox Height="38" Margin="0,5,0,8" Padding="10,7" PasswordChanged="OnWeatherApiKeyChanged" />
                            <TextBlock Text="{Binding WeatherMaskedApiKey, StringFormat=当前：{0}}" Foreground="#64748B" />
                            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                                <Button Content="确认保存" Command="{Binding SaveWeatherCredentialCommand}" IsEnabled="{Binding CanSaveWeatherCredential}" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="测试 API" Command="{Binding TestWeatherCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0" Text="{Binding WeatherCredentialStatus}" Foreground="#475569" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsConnectionsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="本机 DemoApi" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding Snapshot.TestApiAddress}" Foreground="#64748B" />
                                    <TextBlock Margin="0,5,0,0" Text="{Binding ApiConnectionText}" Foreground="#0A8F52" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="测试待办" Command="{Binding TestApiCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="和风天气" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding WeatherApiHost}" Foreground="#64748B" />
                                    <TextBlock Margin="0,5,0,0" Text="{Binding WeatherCredentialStatus}" Foreground="#475569" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="测试天气" Command="{Binding TestWeatherCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Border>
                        <Border Background="#EAF3FF" BorderBrush="#B7D6FA" BorderThickness="1" CornerRadius="10" Padding="16">
                            <TextBlock Text="飞书和普通云端 HTTP 连接器仍属于后续业务模块，本预览包不会把未实现能力显示成已连接。" Foreground="#275D91" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsFiltersPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="过滤规则设置" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0" Text="规则当前只保存在本次 UI 会话中。" Foreground="#64748B" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="新增规则" Command="{Binding AddFilterCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="校验规则" Command="{Binding ValidateFiltersCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding FilterRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FilterRuleViewModel}">
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="0,0,10,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
                                            <TextBox Grid.Column="1" Margin="0,0,10,0" Text="{Binding Field, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
                                            <TextBox Grid.Column="2" Margin="0,0,10,0" Text="{Binding Comparison, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
                                            <TextBox Grid.Column="3" Margin="0,0,14,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
                                            <ToggleButton Grid.Column="4" Margin="0,6,14,0" IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding ToggleCommand}" Style="{StaticResource SwitchStyle}" />
                                            <Button Grid.Column="5" Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="2,2,0,0" Text="{Binding FilterValidationMessage}" Foreground="#475569" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
