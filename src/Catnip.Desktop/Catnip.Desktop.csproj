<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="WPF-UI.Tray" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Catnip.Desktop.Mac\Models\*.cs" Link="Shared\Models\%(Filename)%(Extension)" />
    <Compile Include="..\Catnip.Desktop.Mac\Services\*.cs" Link="Shared\Services\%(Filename)%(Extension)" />
    <Compile Include="..\Catnip.Desktop.Mac\ViewModels\*.cs" Link="Shared\ViewModels\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catnip.Shared\Catnip.Shared.csproj" />
    <ProjectReference Include="..\Catnip.Ipc\Catnip.Ipc.csproj" />
  </ItemGroup>

</Project>
